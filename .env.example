# ==============================================================
# .env.example — Star Light Path
# Copy this file to .env and fill in ALL values.
# NEVER commit .env to version control.
# ==============================================================

# ── Django Core ───────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-secret-key

# Must be False in production
DEBUG=False

# Comma-separated. Add your domain(s) in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL Database ───────────────────────────────────────
POSTGRES_DB=starlightpath
POSTGRES_USER=slpuser
POSTGRES_PASSWORD=replace-with-strong-db-password

# Django DB settings (must match POSTGRES_* above)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=starlightpath
DB_USER=slpuser
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/1

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Security (HTTPS — set all to True in production) ─────────
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Email (SMTP) ──────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
DEFAULT_FROM_EMAIL=Star Light Path <noreply@yourdomain.com>

# ── Admin Notification URL (used in email body) ───────────────
ADMIN_LOGIN_URL=https://yourdomain.com/admin/login

# ── JWT Settings ──────────────────────────────────────────────
SIMPLE_JWT_ACCESS_TOKEN_HOURS=1
SIMPLE_JWT_REFRESH_TOKEN_DAYS=7
SIMPLE_JWT_ROTATE_REFRESH_TOKENS=True
SIMPLE_JWT_BLACKLIST_AFTER_ROTATION=True

# ── OTP / Password Reset ──────────────────────────────────────
PASSWORD_RESET_OTP_TTL=600
PASSWORD_RESET_OTP_LENGTH=5
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
PASSWORD_RESET_MAX_VERIFY_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN=60
PASSWORD_RESET_VERIFIED_TTL=600
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_RESET_OTP_PEPPER=replace-with-a-long-random-pepper-string

# ── API Documentation ─────────────────────────────────────────
SPECTACULAR_TITLE=Star Light Path API
SPECTACULAR_DESCRIPTION=API documentation for Star Light Path
SPECTACULAR_VERSION=1.0.0
SPECTACULAR_SERVE_INCLUDE_SCHEMA=False

# ── Optional Auto-Superuser (Docker entrypoint) ───────────────
# Set these to auto-create a superuser on first container start
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=replace-with-strong-admin-password
DJANGO_SUPERUSER_FULLNAME=Super Admin

# ── Frontend ──────────────────────────────────────────────────
# Must point to your backend API (used at Next.js build time)
NEXT_PUBLIC_API_URL=https://yourdomain.com
