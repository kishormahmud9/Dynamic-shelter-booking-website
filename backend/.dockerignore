# ==============================================================
# .dockerignore — Star Light Path Backend
# ==============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Env files — never include secrets in image
.env
.env.*
!.env.example

# Media files — served from mounted volume
media/

# Static collected files — generated during build
staticfiles/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Version control
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml

# Documentation
*.md
docs/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# OS
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
docker-entrypoint.sh
