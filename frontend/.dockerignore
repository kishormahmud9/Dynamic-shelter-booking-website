# ==============================================================
# .dockerignore — Star Light Path Frontend
# ==============================================================

# Dependencies — reinstalled during build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output — regenerated during build
.next/
out/

# Env files — injected at build time via ARG / at runtime via ENV
.env
.env.*
!.env.example

# Version control
.git/
.gitignore

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml

# Documentation
*.md

# Testing
coverage/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
